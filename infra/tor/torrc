# Tor hidden services (.onion) del nodo de Aegis.
#
# UNA sola instancia de Tor, contenedorizada. Dos hidden services v3:
#   1) aegis-relay → API del relay directa (clientes nativos/directos).
#   2) aegis-web   → puerta .onion de la WEB (navegadores): apunta a Caddy, que sirve la web y
#                    enruta /api al relay bajo el MISMO origen (same-origin, sin CORS).
# Sobre .onion va HTTP plano: el cifrado por capas de Tor ya protege el circuito (y el contenido
# va E2E con libsodium, aparte).
#
# OJO: Tor NO resuelve nombres DNS en HiddenServicePort (exige IP literal). El entrypoint.sh
# resuelve `aegis-relay` y `aegis-caddy` a su IP de la red Docker al arrancar y reescribe una copia
# de este torrc en /tmp. Aquí se dejan los NOMBRES de servicio (legible/portable).

Log notice stderr
DataDirectory /var/lib/tor

# --- 1) Onion DIRECTA del relay (API) — para clientes nativos/directos ---
# El cliente hace fetch a http://<onion> (SIN puerto) → puerto virtual 80 → relay Fastify en 8443.
HiddenServiceDir /var/lib/tor/aegis-relay
HiddenServiceVersion 3
HiddenServicePort 80 aegis-relay:8443
# Defensa anti-DoS (per-service, aplica a la onion de ARRIBA):
#  - IntroDoS: rate-limit en los puntos de introducción (Tor ≥0.4.2, SIEMPRE disponible).
#  - PoW: bajo presión, el cliente resuelve un proof-of-work antes de conectar → inundar sale
#    caro (Tor ≥0.4.8; si la build de Alpine no trae el módulo, es un no-op inofensivo).
#  - MaxStreams: mata circuitos que abren demasiados streams (abuso).
HiddenServiceEnableIntroDoSDefense 1
HiddenServiceEnableIntroDoSRatePerSec 25
HiddenServiceEnableIntroDoSBurstPerSec 200
HiddenServicePoWDefensesEnabled 1
HiddenServiceMaxStreams 32
HiddenServiceMaxStreamsCloseCircuit 1

# --- 2) Onion de la WEB (navegadores) → Caddy:80 (web + /api→relay, same-origin) ---
HiddenServiceDir /var/lib/tor/aegis-web
HiddenServiceVersion 3
HiddenServicePort 80 aegis-caddy:80
# Defensa anti-DoS de la onion de la WEB (mismos criterios que arriba; los navegadores por Tor
# ya resuelven el PoW de forma transparente si el servicio lo exige bajo carga).
HiddenServiceEnableIntroDoSDefense 1
HiddenServiceEnableIntroDoSRatePerSec 25
HiddenServiceEnableIntroDoSBurstPerSec 200
HiddenServicePoWDefensesEnabled 1
HiddenServiceMaxStreams 64
HiddenServiceMaxStreamsCloseCircuit 1

# SOCKS SOLO en el loopback DEL contenedor (127.0.0.1): sin warning "open proxy" y sin exposición
# al bridge. El hidden service no lo necesita; queda para autocomprobar las .onion desde dentro
# (la imagen trae curl):
#   docker compose --profile node exec aegis-tor curl --socks5-hostname 127.0.0.1:9050 http://<onion>/health
SocksPort 127.0.0.1:9050
