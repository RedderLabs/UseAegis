# Tor para la puerta .onion de Aegis en COOLIFY.
#
# A diferencia del nodo (que monta torrc/entrypoint como bind-mounts del repo), aquí se HORNEAN
# en la imagen: Coolify clona el repo y construye, y los bind-mounts de ficheros del repo son
# frágiles/inconsistentes en su flujo. Solo persiste el volumen de datos (/var/lib/tor) → las
# .onion NO cambian entre despliegues.
FROM alpine:3.21

# curl: autocomprobar la .onion desde DENTRO (el SocksPort escucha solo en el loopback del contenedor).
RUN apk add --no-cache tor su-exec curl

# El torrc y el entrypoint específicos de Coolify (nombres de servicio web/relay, sin Caddy).
COPY entrypoint.coolify.sh /usr/local/bin/entrypoint.sh
COPY torrc.coolify /etc/tor/torrc

# El entrypoint fija permisos (tor:tor, 700), resuelve web/relay a IP (Tor no acepta nombres DNS
# en HiddenServicePort), reescribe el torrc y baja privilegios a `tor`.
ENTRYPOINT ["/bin/sh", "/usr/local/bin/entrypoint.sh"]
