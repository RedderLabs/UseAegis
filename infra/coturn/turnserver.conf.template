# coturn — STUN/TURN autoalojado para el WebRTC del Modo B (Fase 4).
#
# Plantilla: el entrypoint sustituye __VARIABLES__ desde el entorno y escribe
# /tmp/turnserver.conf. NO edites este archivo para poner credenciales: van por variables de
# entorno (panel de Coolify), nunca en el repo.
#
# Por qué existe: sin ICE, el Modo B solo atraviesa NAT permisiva (ambos navegadores en la misma
# red). Con un STUN/TURN propio atraviesa NAT entre redes distintas. Se autoaloja A PROPÓSITO:
# un STUN público de terceros vería la IP de cada usuario que arranca el Modo B — justo lo que el
# modelo de amenaza evita. Aquí esa IP la ve un servidor que ya es nuestro (el mismo que sirve la
# web clearnet), así que no añade un observador nuevo.
#
# Lo que coturn NO ve: el contenido. El payload va cifrado E2E por encima (sobres del Modo A /
# datachannel del Modo B) y, además, DTLS-SRTP entre pares. coturn ve metadatos de transporte
# (IPs y volumen), como cualquier relevo. Sobre Tor NO se usa: allí no hay WebRTC.

# ── Escucha ────────────────────────────────────────────────────────────────────────────────
listening-port=3478
tls-listening-port=5349

# IP de escucha DENTRO del contenedor (todas). La IP pública que se anuncia en los candidatos
# ICE es external-ip: en Docker con puertos publicados hay NAT 1:1, así que hay que declararla o
# los candidatos relay salen con la IP interna 172.x y no sirven de nada.
listening-ip=0.0.0.0
external-ip=__TURN_EXTERNAL_IP__

# Rango de puertos de relevo. ESTRECHO a propósito: cada puerto publicado en Docker levanta su
# propio docker-proxy, y un rango de 10k puertos tumba el arranque del host. 41 puertos dan de
# sobra para el volumen de esta fase. Debe coincidir EXACTAMENTE con el `ports:` del compose.
min-port=49160
max-port=49200

# ── Autenticación ──────────────────────────────────────────────────────────────────────────
# Credenciales de larga duración con un único usuario estático: es lo que el cliente puede
# incrustar en build-time (NEXT_PUBLIC_P2P_TURN_USER / _CREDENTIAL). Un TURN abierto es un
# relevo de tráfico gratis para cualquiera, así que sin credenciales no se arranca (lo verifica
# el entrypoint).
lt-cred-mech
realm=__TURN_REALM__
user=__TURN_USER__:__TURN_PASSWORD__

# Sin base de datos: el usuario estático de arriba es toda la lista. Evita arrastrar SQLite.
no-auth-pings
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780

# ── Endurecimiento ─────────────────────────────────────────────────────────────────────────
# Prohíbe relevar hacia la red interna: sin esto, cualquiera con las credenciales usa el TURN
# como pivote hacia el relay, el Postgres o la red del host (SSRF por TURN).
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

no-multicast-peers
no-tlsv1
no-tlsv1_1
# La consola de administración (telnet en 5766) y el endpoint de métricas de Prometheus abrirían
# puertos sin autenticar. `no-cli` cierra la primera; el segundo no se activa (es opt-in).
no-cli

# Cuotas — contención de abuso (mismo criterio que los mem_limit/pids_limit del compose).
# total-quota: sesiones concurrentes en todo el servidor. user-quota: por usuario.
# max-bps: techo por sesión (bytes/s). El datachannel de texto va MUY por debajo.
total-quota=100
user-quota=12
max-bps=256000

# Rotación: coturn escribe a stdout y el logging del compose ya rota.
log-file=stdout
no-loopback-peers
simple-log

# ── TLS (turns:5349) — OPCIONAL ────────────────────────────────────────────────────────────
# Sin certificado montado, el entrypoint arranca SOLO turn:3478 (comenta estas dos líneas).
# El tráfico TURN ya va cifrado por DTLS-SRTP entre pares; turns: sirve sobre todo para
# atravesar cortafuegos que solo dejan salir 443/TLS. Ver docs/aegis-coturn-deploy.md §4.
cert=__TURN_CERT__
pkey=__TURN_PKEY__
