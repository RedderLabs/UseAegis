# ============================================================================
# Aegis — Variables de PRODUCCIÓN (Coolify · puerta clearnet: useaegis.app)
# ============================================================================
# Las consume docker-compose.coolify.yml vía ${VAR}. En Coolify se definen en el panel del
# recurso (Environment Variables), NO en un archivo commiteado. Este .example es la PLANTILLA
# / checklist: refleja el SET REAL de producción con PLACEHOLDERS en los secretos.
#
# ⚠️  NUNCA commitees valores reales (contraseñas de DB/Redis, claves S3). El repo solo lleva
#     este .example; los secretos viven solo en el panel de Coolify.
#
# Etiquetas:
#   [build]   necesaria en BUILD-TIME (build-arg del servicio web; se hornea en el bundle)
#   [runtime] se lee al arrancar el contenedor
#   [coolify] la gestiona Coolify sola (NO la pongas a mano)
# ----------------------------------------------------------------------------

# ── RELAY (Fastify) ─────────────────────────────────────────────────────────
# HOST=0.0.0.0, PORT=8443 y LOG_LEVEL=info van HARDCODED en docker-compose.coolify.yml:
# no hace falta declararlas en el panel.

# [runtime] OBLIGATORIA. Postgres que da Coolify como recurso aparte. Cópiala del recurso
# Postgres de Coolify (host/red INTERNO, no el público). El password es SECRETO → rótalo.
DATABASE_URL=postgres://postgres:REEMPLAZAR_PASSWORD@<host-interno-coolify>:5432/postgres

# [runtime] OPCIONAL. DragonflyDB (Redis-compatible) para el pub/sub del push en tiempo real (SSE).
# Cópiala del recurso Dragonfly de Coolify (host/red INTERNO). Sin ella, los avisos SSE funcionan
# solo en proceso (correcto con una única instancia del relay). El password es SECRETO.
REDIS_URL=redis://default:REEMPLAZAR_PASSWORD@<host-interno-dragonfly>:6379

# [runtime] TTLs de retención (segundos; 30 días por defecto) y tope de un adjunto (bytes; 50 MiB).
BLOB_TTL_SECONDS=2592000
MEDIA_TTL_SECONDS=2592000
MEDIA_MAX_BYTES=52428800

# [runtime] Almacén de objetos S3-compatible para adjuntos cifrados (audio/archivos).
# TODO-O-NADA: si falta cualquiera de las 5, /media responde 503 (el relay arranca igual).
# ⚠️ Las claves S3 eran de PRUEBA — ROTA a claves de producción y no las commitees.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=noctcom-bucket
S3_ACCESS_KEY=REEMPLAZAR
S3_SECRET_KEY=REEMPLAZAR

# [runtime] Redis/Dragonfly (recurso de Coolify). ⚠️ HOY NO SE USA: docker-compose.coolify.yml
# NO se lo pasa al relay y BullMQ aún no está cableado (la mensajería va por polling). Déjala
# lista para cuando entre la cola; hasta entonces es inofensiva pero inerte. Password SECRETO.
# REDIS_URL=redis://:REEMPLAZAR_PASSWORD@<host-interno-coolify>:6379/0

# ── WEB (Next.js) — el navegador solo habla con useaegis.app (same-origin) ───

# [build] Destino del rewrite /api → relay. En Coolify NO hay Caddy, así que ESTE rewrite ES el
# proxy y su destino se hornea en el build. Nombre de servicio interno del compose.
RELAY_ORIGIN=http://relay:8443

# [build] .onion de la WEB, para el enlace "abre nuestra .onion". Vacío = clearnet-only. El compose
# YA trae el servicio `tor` (§9 del doc): tras el 1er deploy saca la dirección con
#   docker compose exec tor cat /var/lib/tor/aegis-web/hostname
# ponla aquí y REDEPLOY (se hornea en el bundle en build-time).
NEXT_PUBLIC_WEB_ONION_URL=

# [build] Umami (analítica de la landing, sin cookies). Las DOS o ninguna. NO son secretas
# (viajan en el bundle público), pero son específicas de tu instancia.
NEXT_PUBLIC_UMAMI_SRC=https://stats.useaegis.app/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=aef14ef8-d10f-4589-8dea-98c5ecb640f9

# ── P2P / Modo B (libp2p, Fase 3) — puerta anti-censura por failover ─────────
# [build] Multiaddr del nodo bootstrap (servicio p2p-bootstrap), coma-separado. Se INCRUSTA en el
# bundle. VACÍO = el candidato P2P no se añade → el chat queda solo relay (idéntico a hoy). Flujo:
#   1) Deja esta vacía en el 1er deploy.
#   2) Asigna el dominio p2p.useaegis.app al servicio p2p-bootstrap (puerto 9001) en Coolify
#      (Traefik termina wss). Añade el DNS A: p2p.useaegis.app → IP pública del host.
#   3) Saca el PeerID de los logs:  docker compose logs p2p-bootstrap | grep PeerID
#   4) Rellena esta con /dns4/p2p.useaegis.app/tcp/443/wss/p2p/<PeerID> y REDEPLOY el servicio web.
NEXT_PUBLIC_P2P_BOOTSTRAP=

# [build] Modo B por la puerta .onion (Tor). Sobre Tor NO hay WebRTC (UDP): el sobre P2P se REENVÍA
# por el circuit-relay (TCP). Ese relay se sirve como PUERTO VIRTUAL 9001 sobre la MISMA onion de la
# web (infra/tor/torrc.coolify), así que NO necesita dominio ni DNS nuevos. VACÍO = sobre Tor el chat
# queda solo relay. Flujo:
#   1) Deja esta vacía hasta tener la onion de la web y el PeerID del bootstrap.
#   2) Saca la dirección .onion de la web:  docker compose exec tor cat /var/lib/tor/aegis-web/hostname
#   3) Saca el PeerID:  docker compose logs p2p-bootstrap | grep PeerID
#   4) Rellena con  /dns4/<web-onion>.onion/tcp/9001/ws/p2p/<PeerID>  y REDEPLOY el servicio web.
NEXT_PUBLIC_P2P_BOOTSTRAP_ONION=

# [runtime] OPCIONAL. Semilla de 32 bytes en hex (64 chars) para FIJAR el PeerID del bootstrap
# entre despliegues/hosts. Si se omite, se genera y se persiste en el volumen aegis-p2p-bootstrap-data
# (estable mientras el volumen exista). Genera una con:  openssl rand -hex 32
P2P_BOOTSTRAP_SEED=

# [build] OPCIONAL. Servidores ICE del WebRTC (solo clearnet: sobre Tor no hay WebRTC). Es lo que
# decide si el Modo B atraviesa NAT entre DOS REDES DISTINTAS. Lo validado en la Fase 3 fue NAT
# permisiva (ambos navegadores en la misma red), donde bastan los candidatos de host.
# VACÍO = sin ICE, A PROPÓSITO: no se mete un STUN público de terceros por defecto (verían la IP de
# cada usuario que arranca el Modo B — justo lo que el modelo de amenaza evita). Autoaloja coturn
# en el mismo host del bootstrap y apúntalo aquí. Lista separada por comas.
#   NEXT_PUBLIC_P2P_ICE_SERVERS=stun:turn.useaegis.app:3478,turns:turn.useaegis.app:5349
NEXT_PUBLIC_P2P_ICE_SERVERS=

# [build] OPCIONAL. Credenciales, aplicadas solo a las entradas turn:/turns: de la lista de arriba.
# Un TURN abierto es un relevo de tráfico gratis para cualquiera: no lo dejes sin credenciales.
NEXT_PUBLIC_P2P_TURN_USER=
NEXT_PUBLIC_P2P_TURN_CREDENTIAL=

# ── coturn: el STUN/TURN autoalojado que sirve las tres de arriba ───────────
# Lado SERVIDOR de lo anterior (servicio `coturn` del compose). Estas son [runtime]: cambiarlas
# NO exige rebuild de la web, solo reiniciar coturn. Las NEXT_PUBLIC_* de arriba sí son build-time.
# Guía completa (DNS, cortafuegos, verificación): docs/aegis-coturn-deploy.md
#
# [runtime] OBLIGATORIA si despliegas coturn. IP pública IPv4 del host. En Docker hay NAT 1:1: sin
# esto, coturn anuncia su IP interna (172.x) y los candidatos ICE no sirven desde fuera.
TURN_EXTERNAL_IP=

# [runtime] OBLIGATORIAS si despliegas coturn: sin ellas el contenedor ABORTA al arrancar (a
# propósito — un TURN sin auth es ancho de banda gratis para cualquiera). Genera la contraseña con:
#   openssl rand -base64 24
# Deben coincidir con NEXT_PUBLIC_P2P_TURN_USER / NEXT_PUBLIC_P2P_TURN_CREDENTIAL de arriba.
TURN_USER=aegis
TURN_PASSWORD=

# [runtime] OPCIONAL. Realm de las credenciales de larga duración. Por defecto useaegis.app.
TURN_REALM=

# ── Gestionadas por Coolify — NO ponerlas a mano ────────────────────────────
# [coolify] SERVICE_URL_WEB / SERVICE_FQDN_WEB → dominio de la web (Traefik/ACME).
# [coolify] NIXPACKS_NODE_VERSION → irrelevante aquí: el build es por Dockerfile, no Nixpacks.
