# ══════════════════════════════════════════════════════════════════════════════════════
# Aegis — plantilla de las variables de DESARROLLO. Copia este fichero a `.env`.
# ══════════════════════════════════════════════════════════════════════════════════════
#
# Hay UN SOLO `.env`, en la raíz. No crees `.env` dentro de `apps/`: los tres consumidores leen
# de aquí y por eso no se pueden desincronizar.
#
#   docker-compose.yml   → lo carga solo (Compose lee el `.env` del directorio del compose)
#   apps/relay           → sus scripts hacen `dotenv -e ../../.env` (dev, serve, migrate, test)
#   apps/web             → sus scripts hacen `dotenv -e ../../.env` (dev, build)
#
# Los valores de aquí son de DEV. PRODUCCIÓN (Coolify, useaegis.app) NO usa este fichero: sus
# variables van en el panel de Coolify y `docker-compose.coolify.yml` las toma con ${VAR}; la
# plantilla/checklist de producción es `.env.coolify.example`.
#
# Fuente de verdad de lo que significa cada variable del relay: `apps/relay/src/config.ts`.

# ── Postgres (contenedor `aegis-db` del compose) ──────────────────────────────────────
# Estas cuatro las lee docker-compose.yml para CREAR el contenedor, y de ellas se deriva la
# DATABASE_URL de más abajo. Cambiar la contraseña aquí NO cambia la de un volumen ya creado:
# hay que recrearlo (`pnpm --filter @aegis/relay infra:reset`, que BORRA los datos de dev).
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_pw
POSTGRES_DB=aegis_relay
# Puerto host de Postgres. NO 5432 (Postgres nativo) ni 5433 (ocupado). Se evita también el rango
# 50000+ porque Windows/WinNAT reserva ahí bloques dinámicos que cambian en cada reinicio (llegan
# a excluir 55432) y rompen el bind del contenedor. 15432 queda por debajo.
POSTGRES_PORT=15432

# Puerto host de DragonflyDB (habla protocolo Redis en :6379 dentro del contenedor).
# Misma razón para el puerto host: fuera del 6379 nativo y del rango dinámico de WinNAT.
REDIS_PORT=16379

# ── Relay (apps/relay) ────────────────────────────────────────────────────────────────
# DERIVADAS de las de arriba: nunca se teclean dos veces, así no pueden desincronizarse.
# Son las del relay corriendo EN EL HOST (`pnpm --filter @aegis/relay dev`). El relay DENTRO del
# compose usa su propia URL por nombre de servicio (`aegis-db:5432`), que arma docker-compose.yml.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}

PORT=8443
HOST=127.0.0.1
# fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Vida de una sesión emitida tras el challenge-response (30 días) y de un challenge (2 min).
SESSION_TTL_SECONDS=2592000
CHALLENGE_TTL_SECONDS=120

# Rate-limiting por IP: ventana en ms + máximos por ventana.
RL_WINDOW_MS=60000
RL_GLOBAL_MAX=120
RL_CHALLENGE_MAX=15
RL_VERIFY_MAX=30
# Directorio (publicar handle/prekey y resolver: el GET es enumerable) y mensajería (una
# conversación activa hace muchas peticiones). Si se omiten, valen los defaults de config.ts.
# RL_DIRECTORY_MAX=60
# RL_MESSAGING_MAX=120

# Cada cuánto barre la tarea de mantenimiento challenges/sesiones/sobres vencidos (segundos).
MAINTENANCE_INTERVAL_SECONDS=300

# En dev el navegador SÍ cruza origen (Next en :3000 → relay en :8443). En producción no hace
# falta: la web reenvía /api server-side (same-origin), por eso en Coolify no se define.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Almacén S3-compatible de adjuntos cifrados (audio/archivos). TODO-O-NADA: si falta cualquiera
# de las 5, `media` = null y las rutas /media responden 503 (el relay arranca igual). En dev
# puedes dejarlas vacías; para probar adjuntos, apunta a un bucket real (B2/R2/S3/MinIO).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cuota de almacenamiento por identidad. EXPLÍCITA a propósito: es la política que decide cuánto
# puede guardar cada quien, así que su número se lee aquí y no se deduce de un default compilado.
# La cuota MADURA con la edad de la identidad: de BASE a MAX en RAMP_DAYS días. Así una identidad
# recién creada vale poco y una granja de cuentas tiene que pagar con tiempo, que no se paraleliza
# (no se puede pedir identidad sin romper el anonimato del producto).
# QUOTA_MAX_BYTES=0 DESACTIVA la cuota (relay autoalojado, donde el disco es tuyo).
QUOTA_BASE_BYTES=104857600      # 100 MB — identidad recién creada
QUOTA_MAX_BYTES=1073741824      # 1 GB   — identidad madura
QUOTA_RAMP_DAYS=30              # días hasta la cuota máxima
QUOTA_DAILY_MIN_BYTES=104857600 # 100 MB — suelo de la ráfaga diaria (el real es max(este, cuota/2))

# Retención. Es lo que hace que la cuota se libere sola: nada se guarda más de 30 días, así que el
# techo "en reposo" coincide con lo que de verdad factura el bucket ($/GB-mes).
BLOB_TTL_SECONDS=2592000        # sobres del buzón (30 días)
MEDIA_TTL_SECONDS=2592000       # objetos de media + su fila de rastreo (30 días)
MEDIA_MAX_BYTES=52428800        # tope de UN objeto (50 MiB), distinto del techo acumulado

# ── Web (apps/web) ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* se inlinean en el bundle del navegador en BUILD-TIME, no en runtime.

# Same-origin: el navegador llama a /api RELATIVO (sin CORS); en dev next.config reescribe
# /api/* → aquí (server-side). Cámbialo si tu relay no está en 127.0.0.1:8443.
RELAY_ORIGIN=http://127.0.0.1:${PORT}

# .onion de la WEB, para el enlace "abre nuestra .onion" en la landing y en Ajustes. Vacío = no
# se muestra el enlace. Se obtiene tras el 1er arranque de Tor:
#   docker compose --profile node exec aegis-tor cat /var/lib/tor/aegis-web/hostname
NEXT_PUBLIC_WEB_ONION_URL=

# Canónica del sitio (metadatos, sitemap, robots). Sin definir → https://useaegis.app.
# NEXT_PUBLIC_SITE_URL=https://useaegis.app

# Umami — analítica SOLO de la landing (sin cookies, sin datos personales). Se activa únicamente
# si defines LAS DOS; si están vacías no se carga ningún script.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Puerto host del panel de Umami (`docker compose --profile umami`).
UMAMI_PORT=13001

# Solo para TESTS en Node: URL ABSOLUTA del relay (la app en el navegador usa /api relativo).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8443

# ── Modo B · P2P (libp2p) ─────────────────────────────────────────────────────────────
# SIN NEXT_PUBLIC_P2P_BOOTSTRAP el chat es solo relay (el candidato P2P ni se registra): dejarlas
# vacías es un modo de funcionamiento válido, no una config a medias. Se hornean en BUILD-TIME.
NEXT_PUBLIC_P2P_BOOTSTRAP=
# Multiaddr del mismo bootstrap alcanzable por Tor (el Modo B sobre .onion va reenviado por el
# circuit-relay: en un navegador sobre Tor no hay WebRTC).
NEXT_PUBLIC_P2P_BOOTSTRAP_ONION=
# ICE para el WebRTC de clearnet. Sin STUN público de terceros por defecto: se autoaloja (coturn).
NEXT_PUBLIC_P2P_ICE_SERVERS=
NEXT_PUBLIC_P2P_TURN_USER=
NEXT_PUBLIC_P2P_TURN_CREDENTIAL=

# ── Nodo bootstrap P2P (infra/p2p-bootstrap · solo si lo levantas en local) ────────────
# Semilla de 32 bytes en HEX (64 chars): fija el PeerID entre reinicios. Sin ella se genera una
# y se guarda en DATA_DIR, así que el multiaddr cambiaría en cada recreación del volumen.
# P2P_BOOTSTRAP_SEED=
# DATA_DIR=/data
# WS_PORT=9001

# ── Dos puertas de la WEB (Caddy + Tor · solo `docker compose --profile node`) ─────────
# La web se sirve por Caddy en dos puertas: clearnet (TLS) y .onion (Tor). El relay va como /api
# bajo el MISMO origen, así el transporte sigue la puerta.
# Sin definir → aegis.local + TLS autofirmado. Producción (Let's Encrypt): dominio real (DNS A →
# IP pública, 80/443 abiertos) + email ACME.
# WEB_DOMAIN=useaegis.app
# WEB_TLS=tu-email@dominio
# Acceso DIRECTO al relay por clearnet (SOLO debug). DÉJALO SIN DEFINIR en producción: emitiría
# un segundo certificado para nada.
# RELAY_DOMAIN=relay.useaegis.app
# RELAY_TLS=tu-email@dominio
# Puerta `wss` del bootstrap P2P servida por Caddy en el nodo.
# P2P_DOMAIN=p2p.useaegis.app
# P2P_TLS=tu-email@dominio

# ── SOLO PRODUCCIÓN — no van aquí, se listan para que no queden invisibles ─────────────
# Estas las lee `docker-compose.coolify.yml` (o el de tor-node) y viven en el panel de Coolify;
# su plantilla es `.env.coolify.example`. No las definas en este fichero: en dev no las usa nadie.
#   TURN_USER · TURN_PASSWORD · TURN_REALM                     (coturn autoalojado del Modo B)
#   TURN_EXTERNAL_HOST | TURN_EXTERNAL_IP · TURN_WATCH_INTERVAL  (IP pública del TURN: nombre DDNS
#                                                                que se refresca solo, o valor fijo)
#   COOLIFY_HOST                                                (host del compose de tor-node)
#   DATABASE_URL / REDIS_URL                                    (allí apuntan a los recursos de
#                                                                Coolify, no a 127.0.0.1)
