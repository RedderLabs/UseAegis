# Variables del servidor PostgreSQL local (las lee docker-compose.yml).
# Copia este archivo a `.env` para desarrollo. Son credenciales de dev, no de producción.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_pw
POSTGRES_DB=aegis_relay
# Puerto host de Postgres. NO 5432 (Postgres nativo) ni 5433 (ocupado). Se evita también
# el rango 50000+ porque Windows/WinNAT reserva ahí bloques dinámicos que cambian en cada
# reinicio (llegan a excluir 55432) y rompen el bind del contenedor. 15432 queda por debajo.
POSTGRES_PORT=15432

# Puerto host de DragonflyDB (habla protocolo Redis en :6379 dentro del contenedor).
# Misma razón para el puerto host: fuera del 6379 nativo y del rango dinámico de WinNAT.
REDIS_PORT=16379

# --- Puerta clearnet (Caddy, solo perfil "node") --------------------------------------
# Estas dos las lee Caddy (via docker-compose) para el TLS del relay. Si las dejas SIN
# definir, quedan los defaults de pruebas locales: relay.aegis.local + certificado
# autofirmado (`tls internal`).
#
# PRODUCCIÓN — dominio real + Let's Encrypt automático. Descomenta y ajusta:
#   RELAY_DOMAIN  = dominio del relay (registro DNS A → IP pública del nodo)
#   RELAY_TLS     = tu email de contacto ACME (activa Let's Encrypt y recibe avisos de caducidad)
# Requisitos: DNS ya apuntando al nodo y puertos 80/443 abiertos desde internet.
# RELAY_DOMAIN=relay.aegis.app
# RELAY_TLS=admin@aegis.app
