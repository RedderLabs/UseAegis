# Variables del servidor PostgreSQL local (las lee docker-compose.yml).
# Copia este archivo a `.env` para desarrollo. Son credenciales de dev, no de producción.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_pw
POSTGRES_DB=aegis_relay
# Puerto host de Postgres. NO 5432 (Postgres nativo) ni 5433 (ocupado). Se evita también
# el rango 50000+ porque Windows/WinNAT reserva ahí bloques dinámicos que cambian en cada
# reinicio (llegan a excluir 55432) y rompen el bind del contenedor. 15432 queda por debajo.
POSTGRES_PORT=15432

# Puerto host de DragonflyDB (habla protocolo Redis en :6379 dentro del contenedor).
# Misma razón para el puerto host: fuera del 6379 nativo y del rango dinámico de WinNAT.
REDIS_PORT=16379

# --- Dos puertas de la WEB (Caddy + Tor, solo perfil "node") --------------------------
# La web se sirve por Caddy en dos puertas: clearnet (TLS) y .onion (Tor). El relay va como
# /api bajo el MISMO origen (same-origin, sin CORS), así el transporte sigue la puerta.
#
# Puerta CLEARNET de la web. Sin definir → pruebas locales: aegis.local + tls internal (autofirmado).
#   Producción (Let's Encrypt): WEB_DOMAIN=dominio real (DNS A → IP pública, 80/443 abiertos) + WEB_TLS=email ACME.
# WEB_DOMAIN=useaegis.app
# WEB_TLS=tu-email@dominio

# Acceso DIRECTO al relay por clearnet (SOLO debug; la app usa /api same-origin). Defaults:
# relay.aegis.local + tls internal. DÉJALO SIN DEFINIR en producción para NO emitir un 2º cert.
# RELAY_DOMAIN=relay.useaegis.app
# RELAY_TLS=tu-email@dominio

# .onion de la WEB, para el enlace "abre nuestra .onion" que se muestra en la puerta clearnet.
# Se obtiene tras el 1er arranque de Tor:
#   docker compose --profile node exec aegis-tor cat /var/lib/tor/aegis-web/hostname
# Ponla aquí y reconstruye la web: docker compose --profile node up -d --build aegis-web
# NEXT_PUBLIC_WEB_ONION_URL=xxxxxxxx.onion
