# Configuración del relay (Auth / AuthSession). Copia a `.env` para desarrollo.

# Cadena de conexión a PostgreSQL. Debe coincidir con POSTGRES_PORT del .env raíz.
# Puerto 15432 (no 5432 nativo; y fuera del rango 50000+ que WinNAT reserva en Windows).
DATABASE_URL=postgres://aegis:aegis_dev_pw@127.0.0.1:15432/aegis_relay

# Redis (base para la cola de blobs con BullMQ; aún no se conecta desde el relay).
REDIS_URL=redis://127.0.0.1:16379

# Puerto HTTP del relay.
PORT=8443
HOST=127.0.0.1

# Vida de una sesión emitida tras el challenge-response (segundos). 30 días por defecto.
SESSION_TTL_SECONDS=2592000

# Vida de un challenge de autenticación antes de expirar (segundos). 2 minutos por defecto.
CHALLENGE_TTL_SECONDS=120

# Nivel de log de Fastify/pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Rate-limiting por IP (ventana en ms + máximos por ventana).
RL_WINDOW_MS=60000
RL_GLOBAL_MAX=120
RL_CHALLENGE_MAX=15
RL_VERIFY_MAX=30
# Directorio: publicar handle/prekey y resolver handles (el GET es enumerable).
RL_DIRECTORY_MAX=60

# Cada cuánto barre la tarea de mantenimiento challenges/sesiones vencidas (segundos).
MAINTENANCE_INTERVAL_SECONDS=300

# Orígenes permitidos por CORS (coma-separados). El cliente web los necesita.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
