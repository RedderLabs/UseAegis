# Configuración del relay (Auth / AuthSession / directorio / buzón / media).
# Copia este archivo a `.env` para DESARROLLO. Los valores son de DEV; NO usar en producción.
# En PRODUCCIÓN (Coolify) las variables van en el panel del recurso, no en un archivo — ver la
# plantilla ../../.env.coolify.example. Fuente de verdad de todas estas variables: src/config.ts.

# ── Base de datos y cola ────────────────────────────────────────────────────

# OBLIGATORIA. Cadena de conexión a PostgreSQL. Debe coincidir con POSTGRES_PORT del .env raíz.
# Puerto 15432 en dev (no 5432 nativo; y fuera del rango 50000+ que WinNAT reserva en Windows).
DATABASE_URL=postgres://aegis:aegis_dev_pw@127.0.0.1:15432/aegis_relay

# DragonflyDB (base para la cola de blobs con BullMQ; AÚN NO se conecta desde el relay).
# Drop-in de Redis: la URL sigue siendo redis:// porque habla el mismo protocolo (RESP).
REDIS_URL=redis://127.0.0.1:16379

# ── Servidor HTTP ───────────────────────────────────────────────────────────

PORT=8443
HOST=127.0.0.1
# Nivel de log de Fastify/pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# ── Sesiones y challenges (segundos) ─────────────────────────────────────────

# Vida de una sesión emitida tras el challenge-response. 30 días por defecto.
SESSION_TTL_SECONDS=2592000
# Vida de un challenge de autenticación antes de expirar. 2 minutos por defecto.
CHALLENGE_TTL_SECONDS=120

# ── Rate-limiting por IP (ventana en ms + máximos por ventana) ───────────────

RL_WINDOW_MS=60000
RL_GLOBAL_MAX=120
RL_CHALLENGE_MAX=15
RL_VERIFY_MAX=30
# Directorio: publicar handle/prekey y resolver handles (el GET es enumerable).
RL_DIRECTORY_MAX=60
# Mensajería: enviar/recibir sobres (una conversación activa hace muchas peticiones).
RL_MESSAGING_MAX=120

# ── Buzón de mensajes y media ────────────────────────────────────────────────

# TTL de los sobres del buzón (se retienen para continuidad cross-puerta). 30 días.
BLOB_TTL_SECONDS=2592000
# TTL de los objetos de media en el bucket + su fila de rastreo. 30 días.
MEDIA_TTL_SECONDS=2592000
# Tope de tamaño de un objeto de media (ciphertext binario, NO base64). 50 MiB.
MEDIA_MAX_BYTES=52428800

# ── Cuota de almacenamiento por identidad ────────────────────────────────────
# Techo de bytes EN REPOSO por identidad (lo almacenado ahora, no un acumulado de por vida: todo
# caduca con MEDIA_TTL_SECONDS y se libera solo). Sin esto, MEDIA_MAX_BYTES × RL_MESSAGING_MAX
# permite ~8 TiB/día a una sola identidad autenticada.
# La cuota MADURA con la edad de la cuenta: de QUOTA_BASE_BYTES a QUOTA_MAX_BYTES en QUOTA_RAMP_DAYS
# días. Así una identidad recién creada vale poco y las granjas de cuentas tienen que pagar con
# tiempo, que no se paraleliza (no se puede pedir identidad sin romper el anonimato del producto).
# QUOTA_MAX_BYTES=0 DESACTIVA la cuota (relay autoalojado donde el disco es tuyo).
QUOTA_BASE_BYTES=104857600
QUOTA_MAX_BYTES=1073741824
QUOTA_RAMP_DAYS=30
# Suelo del tope de ráfaga diaria (el real es max(este, cuota/2)). Controla ancho de banda, no disco.
QUOTA_DAILY_MIN_BYTES=104857600

# Almacén de objetos S3-compatible para adjuntos cifrados (audio/archivos). TODO-O-NADA: si falta
# cualquiera de las 5, `media` = null y las rutas /media responden 503 (el relay arranca igual).
# En dev puedes dejarlas vacías; para probar adjuntos, apunta a un bucket real (B2/R2/S3/MinIO).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Mantenimiento y CORS ─────────────────────────────────────────────────────

# Cada cuánto barre la tarea de mantenimiento challenges/sesiones/sobres vencidos (segundos).
MAINTENANCE_INTERVAL_SECONDS=300

# Orígenes permitidos por CORS (coma-separados). En dev, si se OMITE, se permite cualquier
# localhost/127.0.0.1 (puerto variable de Next). En el modelo same-origin de producción el
# navegador NO cruza origen (la web reenvía /api server-side), por eso en Coolify no se define.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
