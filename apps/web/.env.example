# Variables del cliente web (Next.js). Copia a `.env.local` para DESARROLLO.
# En PRODUCCIÓN (Coolify) van como build-args/env del servicio web — ver ../../.env.coolify.example.
# NEXT_PUBLIC_* se inlinean en el bundle del navegador en BUILD-TIME (no en runtime).

# Modelo same-origin: el navegador llama al relay como /api RELATIVO (sin CORS). En dev,
# next.config reescribe /api/* → RELAY_ORIGIN (server-side). Cámbialo si tu relay no está ahí.
RELAY_ORIGIN=http://127.0.0.1:8443

# .onion de la WEB, para el enlace "abre nuestra .onion" en la landing y Ajustes. Vacío = no se
# muestra el enlace. En el nodo/Coolify va como build-arg (se hornea en el bundle del cliente).
NEXT_PUBLIC_WEB_ONION_URL=

# Umami — analítica SOLO de la landing (sin cookies, sin datos personales). Se activa únicamente
# si defines LAS DOS variables; si están vacías, no se carga ningún script.
#   NEXT_PUBLIC_UMAMI_SRC        = URL del script de tu instancia de Umami (…/script.js)
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID = UUID del sitio que te da Umami al crear el website.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Solo para TESTS en Node: URL ABSOLUTA del relay (la app en el navegador usa /api relativo).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8443
