# URL del relay para el handshake de autenticación (Auth / AuthSession).
# NEXT_PUBLIC_ → se inlinea en el bundle del cliente. Por defecto apunta al relay local.
NEXT_PUBLIC_RELAY_URL=http://127.0.0.1:8443
NEXT_PUBLIC_RELAY_ONION_URL=xxxxxxxx.onion

# Umami — analítica SOLO de la landing (sin cookies, sin datos personales). Se activa únicamente
# si defines LAS DOS variables; en dev, déjalas vacías y no se carga ningún script.
# NEXT_PUBLIC_UMAMI_SRC     = URL del script de tu instancia de Umami (p.ej. https://umami.tu-dominio/script.js)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID = UUID del sitio que te da Umami al crear el website.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
